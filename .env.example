# Enables the signed five-user director console and Demo authentication only.
# Keep false in every formal/production environment.
DEMO_MODE=false
DEMO_SESSION_SECRET=
CROSSPOINT_DB_PATH=.data/crosspoint.sqlite

# Data source. Keep "fixture" for the complete offline Demo.
CROSSPOINT_DATA_SOURCE=fixture

# Enables real, read-only Zhihu calls from server routes only.
ZHIHU_API_ENABLED=false

# Enables the OAuth start/callback routes separately from content APIs.
ZHIHU_OAUTH_ENABLED=false

# Store these in the server environment or deployment secret manager only.
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=

# Optional cache and timeout tuning.
ZHIHU_API_TIMEOUT_MS=8000
ZHIHU_CACHE_TTL_SECONDS=900
